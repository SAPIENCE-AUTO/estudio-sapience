{
  "name": "estudio-sapience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estudio de sesiones en vivo de Sapience: lobby, sala verde, escenario y backstage sobre LiveKit",
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c blue,green \"npm:dev:servidor\" \"npm:dev:web\"",
    "dev:servidor": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "e2e": "tsx pruebas/e2e.ts",
    "ensayo-login": "tsx pruebas/ensayo-login.ts",
    "db:probar": "tsx pruebas/probar-base.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "^4.22.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
