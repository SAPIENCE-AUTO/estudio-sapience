# Copia este archivo a .env y llena los valores. NUNCA subas .env al repositorio.

# --- LiveKit (cuenta propia del estudio para producción; en desarrollo se puede usar una de pruebas) ---
LIVEKIT_WS_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_HTTP_URL=https://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Aplicación ---
PORT=8787
# Firma los pases de los participantes. Cadena larga al azar (mínimo 32 caracteres).
APP_SECRET=
# URL pública donde vive la app (para armar los links que se mandan a la gente).
URL_PUBLICA=http://localhost:5173

# --- Acceso del equipo ---
# dev = sin login (SOLO para desarrollo; el servidor se niega a arrancar así en producción)
# supabase = login real por correo (enlace mágico) con el mismo Supabase del Hub
AUTH_MODE=dev
DEV_EQUIPO_EMAIL=equipo@ejemplo.test
DEV_EQUIPO_NOMBRE=Equipo (dev)
# Solo con AUTH_MODE=supabase. Son los mismos valores SUPABASE_URL y SUPABASE_ANON_KEY que usa el Hub en Render.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Correos del equipo que pueden entrar (coma, espacio o salto de línea). Quien no esté aquí ve «no tiene acceso».
EQUIPO_PERMITIDO=

# --- Conexión con el Hub (para que el Hub cree sesiones por API) ---
# Llave que el Hub manda en "Authorization: Bearer ..." al crear una sesión. Vacía = la ruta queda apagada.
HUB_API_KEY=
